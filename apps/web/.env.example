NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=PIPS
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Signing key for public report share links (/share/report/<token>).
# REQUIRED in production: without it the app refuses to mint or accept share
# links rather than signing with an empty key. Generate with:
#   openssl rand -base64 32
SHARE_TOKEN_SECRET=

# Shared secret for notification email dispatch. Also accepted as a legacy
# fallback for SHARE_TOKEN_SECRET; set SHARE_TOKEN_SECRET separately so report
# links and email dispatch do not share a trust domain.
NOTIFICATION_EMAIL_SECRET=

# Rate limiting. Without both Upstash values the limiter DENIES in production
# rather than silently degrading to a per-instance in-memory counter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set to "true" to accept the weak in-memory limiter in production. Per-instance
# only, and easily evaded on serverless — an explicit, logged opt-out.
ALLOW_IN_MEMORY_RATE_LIMIT=

# Optional: pin the password used by throwaway E2E accounts. Left unset, each
# run generates a random one, so no fixed credential exists in the repo.
E2E_TEST_PASSWORD=
